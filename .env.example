# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/call_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

# Base URL for webhooks
BASE_URL=http://localhost:8000
# CH-514: seconds a buyer's line rings before the call moves to the next buyer.
# 0 = off (as before).
FAILOVER_RING_SECONDS=0
# FAILOVER_MAX_TRIES=10
# LINE_COOLDOWN_MISSES=5
# LINE_COOLDOWN_MINUTES=15
# CH-519: the 15-minute skip is off; a line missing LINE_COOLDOWN_MISSES in a
# row raises an alert instead. Set True only to bring the skip back.
# LINE_COOLDOWN_ENABLED=False
# CH-531: a recording with less than this many seconds of speech is "no voice".
# VOICE_MIN_SECONDS=1.0
# CH-535: paid calls nobody answered (Missed With Conversion, late answers) keep
# their recording link. Set True only after deploy/record_from_dial.py ran on
# Server A and a test call's file was bigger than 44 bytes.
# PAID_MISSED_RECORDING=False
# CH-536: send each "no voice" call at once to the team's Telegram chat(s)
# connected on the Automated Report page (reports bot, REPORTS_BOT_TOKEN).
# VOICE_TELEGRAM_ALERTS=False
# CH-543: seconds of tones on the caller's side that count as "beeping".
# AI_BEEP_SECONDS=0.3
# CH-548: the logins that see the AI audit (billing + audit team emails, comma
# separated). The owner always does; empty = the owner only.
# AI_AUDIT_EMAILS=
# CH-549: speech-to-text test (scripts/ai_compare). AssemblyAI is read by the app too.
# DEEPGRAM_API_KEY=
# CH-553: Voicemail / IVR = no speech and music for at least N s and this share of the call.
# AI_MUSIC_SECONDS=4
# AI_MUSIC_SHARE=0.4
# CH-555: final AI label - transcript + LLM (scripts/ai_final, Server B host).
# AI_STT_PROVIDER=assemblyai          # or deepgram (the winner of the CH-549 test)
# AI_LLM_PROVIDER=anthropic           # or openai
# AI_LLM_MODEL=claude-haiku-5-5       # required for openai (the GPT model Sir picks)
# AI_FINAL_MAX_SECONDS=300            # seconds of each call sent: cost cap
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CH-546: Telegram - publisher No Voice % in the last hour, daily summary hour (EST).
# AI_RATE_ALERT_PERCENT=15
# AI_RATE_ALERT_MIN_CALLS=10
# AI_DAILY_SUMMARY_HOUR=9
