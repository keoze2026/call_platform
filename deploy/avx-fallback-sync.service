# Server A only (CH-464): keeps the fallback routing plan fresh and sends the
# calls Server A routed on its own to Server B. Installed (and restarted) by
# scripts/fallback/install_a.sh, which copies the code to
# /usr/local/lib/avortyx/fallback (CH-466). First time also:
#   systemctl enable avx-fallback-sync
[Unit]
Description=Avortyx fallback routing sync (Server A <-> Server B)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/avortyx/fallback/fallback_sync.py --loop
Restart=always
RestartSec=5
StandardOutput=append:/var/log/fallback_sync.log
StandardError=append:/var/log/fallback_sync.log

[Install]
WantedBy=multi-user.target
